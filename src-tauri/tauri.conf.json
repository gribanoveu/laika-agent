{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atlas-desktop",
  "version": "0.1.0",
  "identifier": "com.eugene.atlas-desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "atlas-desktop",
        "decorations": false,
        "transparent": true,
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "models/potion-multilingual-128M-int8-ru-en"
    ]
  }
}
